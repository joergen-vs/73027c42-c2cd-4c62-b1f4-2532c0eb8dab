			<xs:documentation>C000</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="addml:typeUnit">
				<xs:sequence>
					<xs:element name="format" minOccurs="0" type="addml:formatType" />
					<xs:element name="version" type="addml:versionDataType" minOccurs="0"/>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:complexType name="dataFileType">
		<xs:annotation>
			<xs:documentation>C000</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="addml:fileType">
				<xs:sequence>
					<xs:element name="charset" type="addml:charset" minOccurs="0" />
					<xs:element name="charDefinitions" minOccurs="0">
						<xs:complexType>
							<xs:annotation>
								<xs:documentation>tbd</xs:documentation>
							</xs:annotation>
							<xs:sequence>
								<xs:element name="charDefinition" maxOccurs="unbounded">
									<xs:complexType>
										<xs:sequence>
											<xs:element name="fromChar" type="addml:charDefinitionUnit">
												<xs:annotation>
													<xs:documentation>tbd</xs:documentation>
												</xs:annotation>
											</xs:element>
											<xs:element name="toChar" type="addml:charDefinitionUnit">
												<xs:annotation>
													<xs:documentation>tbd</xs:documentation>
												</xs:annotation>
											</xs:element>
										</xs:sequence>
									</xs:complexType>
								</xs:element>
							</xs:sequence>
						</xs:complexType>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	
	<xs:complexType name="charDefinitionUnit">
		<xs:simpleContent>
			<xs:extension base="xs:string">
				<xs:attribute name="format" type="addml:NonEmptyString" default="text">
					<xs:annotation>
						<xs:documentation>Enables different ways of representing the character</xs:documentation>
						<xs:documentation>'text', 'hex' or similar</xs:documentation>
					</xs:annotation>
				</xs:attribute>
			</xs:extension>
		</xs:simpleContent>
	</xs:complexType>

	<xs:complexType name="fixedFileType">
		<xs:annotation>
			<xs:documentation>C000</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="addml:dataFileType">
				<xs:sequence>
					<xs:element name="recordSeparator" type="addml:recordSeparator" minOccurs="0"/>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:complexType name="patternFileType">
		<xs:annotation>
			<xs:documentation>C000</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="addml:dataFileType">
				<xs:sequence>
					<xs:element name="recordSeparator" type="addml:recordSeparator" minOccurs="0"/>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:complexType name="delimitedFileType">
		<xs:annotation>
			<xs:documentation>C000</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="addml:dataFileType">
				<xs:sequence>
					<xs:element name="recordSeparator" type="addml:recordSeparator" minOccurs="0"/>
					<xs:element name="fieldSeparator" type="addml:fieldSeparator"/>
					<xs:element name="quotingChar" type="addml:NonEmptyString" minOccurs="0"/>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:complexType name="xmlFileType">
		<xs:complexContent>
			<xs:extension base="addml:dataFileType" />
		</xs:complexContent>
	</xs:complexType>

	<xs:complexType name="jsonFileType">
		<xs:complexContent>
			<xs:extension base="addml:dataFileType" />
		</xs:complexContent>
	</xs:complexType>

	<xs:complexType name="siardFileType">
		<xs:complexContent>
			<xs:extension base="addml:fileType" />
		</xs:complexContent>
	</xs:complexType>

	<xs:complexType name="recordType">
		<xs:annotation>
			<xs:documentation>C000</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="addml:typeUnit">
				<xs:sequence>
					<xs:element name="trimmed" minOccurs="0">
						<xs:annotation>
							<xs:documentation>TBD: Tabell- mot journal-format</xs:documentation>
						</xs:annotation>
						<xs:complexType/>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:complexType name="fixedRecordType">
		<xs:annotation>
			<xs:documentation>C000</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="addml:recordType">
				<xs:sequence>
					<xs:element name="recordSeparator" type="addml:recordSeparator" minOccurs="0"/>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:complexType name="delimitedRecordType">
		<xs:annotation>
			<xs:documentation>C000</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="addml:recordType">
				<xs:sequence>
					<xs:element name="recordSeparator" type="addml:recordSeparator" minOccurs="0"/>
					<xs:element name="fieldSeparator" type="addml:fieldSeparator"/>
					<xs:element name="quotingChar" type="addml:NonEmptyString" minOccurs="0"/>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:complexType name="xmlRecordType">
		<xs:annotation>
			<xs:documentation>C000</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="addml:recordType" />
		</xs:complexContent>
	</xs:complexType>

	<xs:complexType name="patternRecordType">
		<xs:annotation>
			<xs:documentation>C000</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="addml:recordType">
				<xs:sequence>
					<xs:element name="recordSeparator" type="addml:recordSeparator" minOccurs="0"/>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:complexType name="fieldType">
		<xs:annotation>
			<xs:documentation>C000</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="addml:typeUnit">
				<xs:sequence>
					<xs:group ref="addml:fieldTypeProperties"/>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:group name="fieldTypeProperties">
		<xs:sequence>
			<xs:element name="dataType" type="addml:dataType">
				<xs:annotation>
					<xs:documentation/>
				</xs:annotation>
			</xs:element>
			<xs:element name="fieldFormat" minOccurs="0">
				<xs:complexType>
					<xs:simpleContent>
						<xs:extension base="addml:NonEmptyString">
							<xs:attribute name="type" type="addml:format" use="optional">
								<xs:annotation>
									<xs:documentation>Regex, 'Date/time Seven-property Model' or ISO</xs:documentation>
								</xs:annotation>
							</xs:attribute>
						</xs:extension>
					</xs:simpleContent>
				</xs:complexType>
			</xs:element>
			<xs:element name="alignment" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Aligns content to left, center or right.</xs:documentation>
					<xs:documentation>TODO: Should it be defined here, or not?</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="right"/>
						<xs:enumeration value="left"/>
						<xs:enumeration value="center"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="padChar" type="addml:NonEmptyString" minOccurs="0">
				<xs:annotation>
					<xs:documentation/>
				</xs:annotation>
			</xs:element>
			<xs:element name="packType" type="addml:NonEmptyString" minOccurs="0">
				<xs:annotation>
					<xs:documentation/>
				</xs:annotation>
			</xs:element>
			<xs:element name="nullValues" minOccurs="0">
				<xs:annotation>
					<xs:documentation/>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="nullValue" type="xs:string" maxOccurs="unbounded"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:group>

	<xs:complexType name="attributeType">
		<xs:annotation>
			<xs:documentation>C000</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="addml:typeUnit">
				<xs:sequence>
					<xs:group ref="addml:fieldTypeProperties"/>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<!-- 9: Processes -->

	<xs:complexType name="processSection">
		<xs:annotation>
			<xs:documentation>C000</xs:documentation>
			<xs:documentation>How to review information</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="process" type="addml:process" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="process">
		<xs:complexContent>
			<xs:extension base="addml:unit">
				<xs:sequence>
					<xs:element name="reference" type="addml:name" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Reference to unit process whould be run on</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="parameter" type="addml:parameter" minOccurs="0" maxOccurs="unbounded"/>
				</xs:sequence>
				<xs:attribute name="definitionReference" type="addml:definitionReference"
					use="required">
					<xs:annotation>
						<xs:documentation>Reference to the definition regarding processes for dataset</xs:documentation>
						<xs:documentation>Rules in standard, support by testing-tool, etc. Ex: validating documented number of records against read in file</xs:documentation>
						<xs:documentation>Can also be used to link an extraction to different testsuites, "this extraction has these processes with this testsuite"</xs:documentation>
					</xs:annotation>
				</xs:attribute>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:complexType name="parameter">
		<xs:annotation>
			<xs:documentation>May be used for input when supported by software</xs:documentation>
			<xs:documentation>Ex: field A defines a relative path, and field B defines checksum-value of file. Then refer to field A and B by the rules of the software. Like a cli function-call ControlChecksum path=A algorithm=SHA-256 checksumValue=B</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="addml:unit">
				<xs:sequence>
					<xs:element name="key" type="addml:value"/>
					<xs:element name="value" type="addml:value" minOccurs="0"/>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<!-- 10: Objects -->

	<xs:complexType name="unit" abstract="true">
		<xs:annotation>
			<xs:documentation>C000</xs:documentation>
			<xs:documentation>Base unit</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="identifier" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Unique ID for unit, such as uuid or namespace-referance</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:simpleContent>
						<xs:extension base="addml:value">
							<xs:attribute name="namespace" type="addml:namespace" />
						</xs:extension>
					</xs:simpleContent>
				</xs:complexType>
			</xs:element>
			<xs:element name="description" type="addml:description" minOccurs="0"	maxOccurs="unbounded"/>
			<xs:element name="property" type="addml:property" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
		<xs:attribute name="name" type="addml:name" use="required"/>
		<xs:attribute name="label" type="addml:label" use="optional"/>
	</xs:complexType>

	<xs:complexType name="element">
		<xs:annotation>
			<xs:documentation>C000</xs:documentation>
			<xs:documentation>Defines an element with a value and optional child-elements.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="addml:unit">
				<xs:sequence>
					<xs:group ref="addml:ValueOrObject" minOccurs="0" />
					<xs:element name="element" type="addml:element" minOccurs="0" maxOccurs="unbounded"/>
				</xs:sequence>
				<xs:attribute name="namespace" type="addml:namespace" />
				<xs:attribute name="dataType" type="addml:dataType" />
				<xs:attribute name="format" type="addml:format" />
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:complexType name="property">
		<xs:annotation>
			<xs:documentation>C000</xs:documentation>
			<xs:documentation>Defines a property with a value, complex xml-structure and/or child-properties.</xs:documentation>
			<xs:documentation>Allows further </xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="addml:unit">
				<xs:sequence>
					<xs:group ref="addml:ValueOrObject" minOccurs="0" />
				</xs:sequence>
				<xs:attribute name="namespace" type="addml:namespace" />
				<xs:attribute name="dataType" type="addml:dataType" />
				<xs:attribute name="format" type="addml:format" />
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	
	<xs:complexType name="numberOfOccurrences">
		<xs:sequence>
			<xs:element name="reference" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Allows to identify any, one or more items to sum up, such as "*.pdf" + "*.tiff" for 'archival formats'</xs:documentation>
					<xs:documentation>When reference is not used, the value defines the total number of sub-units.</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:simpleContent>
						<xs:extension base="addml:NonEmptyString">
							<xs:attribute name="type" type="addml:format">
								<xs:annotation>
									<xs:documentation>TODO: xpath, filepath with wildcards, fieldname etc.</xs:documentation>
								</xs:annotation>
							</xs:attribute>
						</xs:extension>
					</xs:simpleContent>
				</xs:complexType>
			</xs:element>
			<xs:element name="value" type="xs:nonNegativeInteger" />
		</xs:sequence>
		<xs:attribute name="name" type="addml:name">
			<xs:annotation>
				<xs:documentation>Defines a name for the items, (e.g. PDF, Record X). No name should refer to unit/@name</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>

	<!-- 11: Variables -->

	<xs:simpleType name="name">
		<xs:annotation>
			<xs:documentation>S000</xs:documentation>
			<xs:documentation>Identifying machine- or human-readable name of object</xs:documentation>
		</xs:annotation>
		<xs:restriction base="addml:NonEmptyString"/>
	</xs:simpleType>

	<xs:simpleType name="label">
		<xs:annotation>
			<xs:documentation>S000</xs:documentation>
			<xs:documentation>Human-readable name of object</xs:documentation>
		</xs:annotation>
		<xs:restriction base="addml:NonEmptyString"/>
	</xs:simpleType>

	<xs:simpleType name="value">
		<xs:annotation>
			<xs:documentation>S000</xs:documentation>
			<xs:documentation>Value of object</xs:documentation>
		</xs:annotation>
		<xs:restriction base="addml:NonEmptyString"/>
	</xs:simpleType>

	<xs:complexType name="object">
		<xs:annotation>
			<xs:documentation>S000</xs:documentation>
			<xs:documentation>Complex object outside the addml-domain</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:any namespace="##any" maxOccurs="unbounded" processContents="lax"/>
		</xs:sequence>
	</xs:complexType>

	<xs:simpleType name="namespace">
		<xs:annotation>
			<xs:documentation>S000</xs:documentation>
			<xs:documentation>Reference to a collection of properties</xs:documentation>
		</xs:annotation>
		<xs:restriction base="addml:NonEmptyString"/>
	</xs:simpleType>

	<xs:simpleType name="dataType">
		<xs:annotation>
			<xs:documentation>S000</xs:documentation>
			<xs:documentation>Datatype of the property.value</xs:documentation>
		</xs:annotation>
		<xs:restriction base="addml:NonEmptyString"/>
	</xs:simpleType>

	<xs:simpleType name="format">
		<xs:annotation>
			<xs:documentation>S000</xs:documentation>
			<xs:documentation>Format of the value</xs:documentation>
		</xs:annotation>
		<xs:restriction base="addml:NonEmptyString"/>
	</xs:simpleType>

	<xs:simpleType name="recordReference">
		<xs:annotation>
			<xs:documentation>Reference to a record located inside current object.</xs:documentation>
			<xs:documentation>May use different record-type.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="addml:NonEmptyString"/>
	</xs:simpleType>

	<xs:simpleType name="definitionReference">
		<xs:annotation>
			<xs:documentation>S000</xs:documentation>
			<xs:documentation>Reference to definition-object which contains the description of the file.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="addml:NonEmptyString"/>
	</xs:simpleType>

	<xs:simpleType name="typeReference">
		<xs:annotation>
			<xs:documentation>References an expected format.</xs:documentation>
			<xs:documentation>S000</xs:documentation>
			<xs:documentation>Ex: A standard specifying files to be of xml-format</xs:documentation>
			<xs:documentation>Ex: Field with boolean value True and False, while definition uses 1 and 0, uses different structureTypes, but will be transform-able, due to being read as boolean values.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="addml:NonEmptyString"/>
	</xs:simpleType>

	<xs:attributeGroup name="MinMaxAttributes">
		<xs:annotation>
			<xs:documentation>S000</xs:documentation>
			<xs:documentation>Assigns a number of occurrences to a unit as part of a composition</xs:documentation>
		</xs:annotation>
		<xs:attribute name="min" default="1">
			<xs:annotation>
				<xs:documentation>Minimum, from 0 up.</xs:documentation>
				<xs:documentation>0 = null-able,</xs:documentation>
				<xs:documentation>1 = Default</xs:documentation>
			</xs:annotation>
			<xs:simpleType>
				<xs:restriction base="xs:nonNegativeInteger"/>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="max" default="1">
			<xs:annotation>
				<xs:documentation>Maximum, from 1 up, included 'unbounded'.</xs:documentation>
				<xs:documentation>1 = Default,</xs:documentation>
				<xs:documentation>'unbounded' = No specific limit / '1 or more'</xs:documentation>
			</xs:annotation>
			<xs:simpleType>
				<xs:union>
					<xs:simpleType>
						<xs:restriction base="xs:nonNegativeInteger"/>
					</xs:simpleType>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:enumeration value="unbounded"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:union>
			</xs:simpleType>
		</xs:attribute>
	</xs:attributeGroup>

	<xs:simpleType name="role">
		<xs:annotation>
			<xs:documentation>S000</xs:documentation>
			<xs:documentation>Role of agent</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="CREATOR"/>
			<xs:enumeration value="EDITOR"/>
			<xs:enumeration value="ARCHIVIST"/>
			<xs:enumeration value="PRESERVATION"/>
			<xs:enumeration value="DISSEMINATOR"/>
			<xs:enumeration value="CUSTODIAN"/>
			<xs:enumeration value="IPOWNER"/>
			<xs:enumeration value="OTHER"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="algorithmValue">
		<xs:annotation>
			<xs:documentation>S014</xs:documentation>
			<xs:documentation>Checksum-algorithm used for calculating filehash</xs:documentation>
		</xs:annotation>
		<xs:union>
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:enumeration value="MD5"/>
					<xs:enumeration value="SHA-256"/>
					<xs:enumeration value="SHA-512"/>
				</xs:restriction>
			</xs:simpleType>
			<xs:simpleType>
				<xs:restriction base="addml:NonEmptyString">
					<xs:annotation>
						<xs:documentation>Allows non-specified hash-algorithms</xs:documentation>
					</xs:annotation>
				</xs:restriction>
			</xs:simpleType>
		</xs:union>
	</xs:simpleType>

	<xs:simpleType name="folderType">
		<xs:annotation>
			<xs:documentation>S000</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="DATAFILES"/>
			<xs:enumeration value="DOCUMENTATION"/>
			<xs:enumeration value="DOCUMENTS"/>
			<xs:enumeration value="REPORTS"/>
			<xs:enumeration value="OTHER"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="conceptDataValue">
		<xs:annotation>
			<xs:documentation>S000</xs:documentation>
			<xs:documentation>
				Consists of a small structural ontology, along with validating against others.

				Duplicate a simpleType with enumeration-values and edit for ontologies for documentation-purposes.
			</xs:documentation>
		</xs:annotation>
		<xs:union>
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:enumeration value="addml:subTypeOf">
						<xs:annotation>
							<xs:documentation>Reference to subtype of definition.</xs:documentation>
							<xs:documentation>Ex: (a, b) is subtype of (a, b, c*) [Specialised entity]</xs:documentation>
						</xs:annotation>
					</xs:enumeration>
					<xs:enumeration value="addml:superTypeOf">
						<xs:annotation>
							<xs:documentation>Reference to supertype of definition.</xs:documentation>
							<xs:documentation>Ex: (a, b) is supertype of (a, b, c) [Generalised entity, ]</xs:documentation>
						</xs:annotation>
					</xs:enumeration>
					<xs:enumeration value="addml:variantOf">
						<xs:annotation>
							<xs:documentation>Reference to variant of definition.</xs:documentation>
							<xs:documentation>Ex: (a, b, c) is variant of (a, b, c*) [Different restraints on same field/record]</xs:documentation>
						</xs:annotation>
					</xs:enumeration>
					<xs:enumeration value="addml:hasFile">
						<xs:annotation>
							<xs:documentation>Defines relation between container-level and file-object</xs:documentation>
						</xs:annotation>
					</xs:enumeration>
					<xs:enumeration value="addml:hasFolder">
						<xs:annotation>
							<xs:documentation>Defines relation between container-level and folder-object</xs:documentation>
						</xs:annotation>
					</xs:enumeration>
					<xs:enumeration value="addml:hasRecord">
						<xs:annotation>
							<xs:documentation>Defines relation between container-level or specific object and record</xs:documentation>
						</xs:annotation>
					</xs:enumeration>
					<xs:enumeration value="addml:hasField">
						<xs:annotation>
							<xs:documentation>Defines relation between record and field</xs:documentation>
						</xs:annotation>
					</xs:enumeration>
					<xs:enumeration value="addml:hasAttribute">
						<xs:annotation>
							<xs:documentation>Defines relation between field and attribute</xs:documentation>
						</xs:annotation>
					</xs:enumeration>
					<xs:enumeration value="addml:hasCode">
						<xs:annotation>
							<xs:documentation>Defines relation between field and code</xs:documentation>
						</xs:annotation>
					</xs:enumeration>
					<!-- Define thesaurus for -->
					<!-- UML -->
					<xs:enumeration value="uml:aggregation">
						<xs:annotation>
							<xs:documentation>Aggregation is a special form of association where one object contains another object. However, the contained object can exist independently of the container. In other words, the lifetime of the contained object is not dependent on the lifetime of the container.</xs:documentation>
						</xs:annotation>
					</xs:enumeration>
					<xs:enumeration value="uml:composition">
						<xs:annotation>
							<xs:documentation>Composition is a stronger form of association where one object contains another object, and the contained object cannot exist independently of the container. In other words, the lifetime of the contained object depends on the lifetime of the container.</xs:documentation>
						</xs:annotation>
					</xs:enumeration>
					<xs:enumeration value="uml:association">
						<xs:annotation>
							<xs:documentation>Association represents a relationship where one object is linked to another object. The association can be one-way or two-way. It implies that two classes are related, but neither class owns the other.</xs:documentation>
						</xs:annotation>
					</xs:enumeration>
				</xs:restriction>
			</xs:simpleType>
			<xs:simpleType>
				<xs:annotation>
					<xs:documentation>Allows the declaration of other ontologies.</xs:documentation>
				</xs:annotation>
				<!-- And more -->
				<xs:restriction base="xs:string">
					<xs:pattern value=".+" />
				</xs:restriction>
			</xs:simpleType>
		</xs:union>
	</xs:simpleType>

	<xs:simpleType name="definitionType">
		<xs:annotation>
			<xs:documentation>S000</xs:documentation>
			<xs:documentation>Pre-defined values and allowing other values</xs:documentation>
		</xs:annotation>
		<xs:union>
			<!--  -->
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:enumeration value="container">
						<xs:annotation>
							<xs:documentation>Reference to a container-level definition.</xs:documentation>
							<xs:documentation>Ex: Extraction, System or System component</xs:documentation>
						</xs:annotation>
					</xs:enumeration>
					<xs:enumeration value="file">
						<xs:annotation>
							<xs:documentation>Reference a file-level definition.</xs:documentation>
						</xs:annotation>
					</xs:enumeration>
					<xs:enumeration value="record">
						<xs:annotation>
							<xs:documentation>Reference a record-level definition.</xs:documentation>
						</xs:annotation>
					</xs:enumeration>
					<xs:enumeration value="field">
						<xs:annotation>
							<xs:documentation>Reference a field-level definition.</xs:documentation>
						</xs:annotation>
					</xs:enumeration>
					<xs:enumeration value="attribute">
						<xs:annotation>
							<xs:documentation>Reference a attribute-level definition.</xs:documentation>
						</xs:annotation>
					</xs:enumeration>
					<xs:enumeration value="code">
						<xs:annotation>
							<xs:documentation>Reference a code-level definition.</xs:documentation>
						</xs:annotation>
					</xs:enumeration>
				</xs:restriction>
			</xs:simpleType>
			<xs:simpleType>
				<xs:annotation>
					<xs:documentation>Allows the declaration of other levels / modules.</xs:documentation>
					<xs:documentation>Ex: "Business function", such as "disposal" and "audit"</xs:documentation>
				</xs:annotation>
				<xs:restriction base="xs:string">
					<xs:pattern value=".+" />
				</xs:restriction>
			</xs:simpleType>
		</xs:union>
	</xs:simpleType>

	<xs:simpleType name="modelType">
		<xs:annotation>
			<xs:documentation>S000</xs:documentation>
			<xs:documentation>Pre-defined values and allowing other values</xs:documentation>
		</xs:annotation>
		<xs:union>
			<!--  -->
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<!-- UML -->
					<xs:enumeration value="aggregation">
						<xs:annotation>
							<xs:documentation>Reference to a container-level definition.</xs:documentation>
							<xs:documentation>Ex: Extraction or System</xs:documentation>
						</xs:annotation>
					</xs:enumeration>
					<xs:enumeration value="composition">
						<xs:annotation>
							<xs:documentation>Reference a file-level definition.</xs:documentation>
						</xs:annotation>
					</xs:enumeration>
					<xs:enumeration value="association">
						<xs:annotation>
							<xs:documentation>Reference a record-level definition.</xs:documentation>
						</xs:annotation>
					</xs:enumeration>
				</xs:restriction>
			</xs:simpleType>
			<xs:simpleType>
				<xs:annotation>
					<xs:documentation>Allows the declaration of other modeling methods.</xs:documentation>
				</xs:annotation>
				<xs:restriction base="xs:string">
					<xs:pattern value=".+" />
				</xs:restriction>
			</xs:simpleType>
		</xs:union>
	</xs:simpleType>

	<xs:simpleType name="formatType">
		<xs:annotation>
			<xs:documentation>S000</xs:documentation>
		</xs:annotation>
		<xs:union>
			<xs:simpleType>
				<xs:restriction base="addml:NonEmptyString">
					<xs:enumeration value="FIXED">
						<xs:annotation>
							<xs:documentation>Fixed-length records with possible newline separators between records</xs:documentation>
						</xs:annotation>
					</xs:enumeration>
					<xs:enumeration value="CSV">
						<xs:annotation>
							<xs:documentation>
								Comma-separated values, that uses a comma to separate
								values.
							</xs:documentation>
						</xs:annotation>
					</xs:enumeration>
					<xs:enumeration value="TSV">
						<xs:annotation>
							<xs:documentation>
								Tabular-separated values, that uses a tab to separate
								values.
							</xs:documentation>
						</xs:annotation>
					</xs:enumeration>
					<xs:enumeration value="DELIMITED">
						<xs:annotation>
							<xs:documentation>
								Custom delimited file format, using custom characters for
								separation and quotation.
							</xs:documentation>
						</xs:annotation>
					</xs:enumeration>
					<xs:enumeration value="XML">
						<xs:annotation>
							<xs:documentation>Formatted according to Extensible Markup Language (XML).</xs:documentation>
						</xs:annotation>
					</xs:enumeration>
				</xs:restriction>
			</xs:simpleType>
			<xs:simpleType>
				<xs:restriction base="addml:NonEmptyString">
					<xs:pattern value=".+">
						<xs:annotation>
							<xs:documentation>Other, yet to be specified</xs:documentation>
						</xs:annotation>
					</xs:pattern>
				</xs:restriction>
			</xs:simpleType>
		</xs:union>
	</xs:simpleType>

	<xs:simpleType name="charset">
		<xs:annotation>
			<xs:documentation>S000</xs:documentation>
		</xs:annotation>
		<xs:union>
			<xs:simpleType>
				<xs:restriction base="addml:NonEmptyString">
					<xs:enumeration value="UTF-8">
						<xs:annotation>
							<xs:documentation>Unicode is a variable-length character encoding standard, and UTF-8 represents characters between 1 and 4 byte.</xs:documentation>
						</xs:annotation>
					</xs:enumeration>
					<xs:enumeration value="OTHER">
						<xs:annotation>
							<xs:documentation>No identifiable charset</xs:documentation>
						</xs:annotation>
					</xs:enumeration>
				</xs:restriction>
			</xs:simpleType>
			<xs:simpleType>
				<xs:restriction base="addml:NonEmptyString">
					<xs:pattern value=".+">
						<xs:annotation>
							<xs:documentation>Other, yet to be specified</xs:documentation>
						</xs:annotation>
					</xs:pattern>
				</xs:restriction>
			</xs:simpleType>
		</xs:union>
	</xs:simpleType>

	<xs:simpleType name="recordSeparator">
		<xs:annotation>
			<xs:documentation>S000</xs:documentation>
		</xs:annotation>
		<xs:union>
			<xs:simpleType>
				<xs:restriction base="addml:NonEmptyString">
					<xs:enumeration value="CR">
						<xs:annotation>
							<xs:documentation>Carriage Return</xs:documentation>
						</xs:annotation>
					</xs:enumeration>
					<xs:enumeration value="LF">
						<xs:annotation>
							<xs:documentation>Line Feed</xs:documentation>
						</xs:annotation>
					</xs:enumeration>
					<xs:enumeration value="CRLF">
						<xs:annotation>
							<xs:documentation>Combination</xs:documentation>
						</xs:annotation>
					</xs:enumeration>
				</xs:restriction>
			</xs:simpleType>
			<xs:simpleType>
				<xs:restriction base="addml:NonEmptyString">
					<xs:pattern value=".+">
						<xs:annotation>
							<xs:documentation>Other, yet to be specified</xs:documentation>
						</xs:annotation>
					</xs:pattern>
				</xs:restriction>
			</xs:simpleType>
		</xs:union>
	</xs:simpleType>

	<xs:simpleType name="fieldSeparator">
		<xs:annotation>
			<xs:documentation>S000</xs:documentation>
		</xs:annotation>
		<xs:union>
			<xs:simpleType>
				<xs:restriction base="addml:NonEmptyString">
					<xs:enumeration value=",">
						<xs:annotation>
							<xs:documentation>
								Comma-separated values, that uses a comma to separate
								values.
							</xs:documentation>
						</xs:annotation>
					</xs:enumeration>
					<xs:enumeration value=";">
						<xs:annotation>
							<xs:documentation>
								Semicolon-separated values, that uses a comma to separate
								values.
							</xs:documentation>
						</xs:annotation>
					</xs:enumeration>
					<xs:enumeration value="TAB">
						<xs:annotation>
							<xs:documentation>
								Tabular-separated values, that uses tabulator to separate
								values.
							</xs:documentation>
						</xs:annotation>
					</xs:enumeration>
				</xs:restriction>
			</xs:simpleType>
			<xs:simpleType>
				<xs:restriction base="addml:NonEmptyString">
					<xs:pattern value=".+">
						<xs:annotation>
							<xs:documentation>Other, yet to be specified</xs:documentation>
						</xs:annotation>
					</xs:pattern>
				</xs:restriction>
			</xs:simpleType>
		</xs:union>
	</xs:simpleType>

	<xs:simpleType name="quotingChararcher">
		<xs:annotation>
			<xs:documentation>S000</xs:documentation>
		</xs:annotation>
		<xs:union>
			<xs:simpleType>
				<xs:restriction base="addml:NonEmptyString">
					<xs:enumeration value="&quot;">
						<xs:annotation>
							<xs:documentation>
								Double-quote
							</xs:documentation>
						</xs:annotation>
					</xs:enumeration>
				</xs:restriction>
			</xs:simpleType>
			<xs:simpleType>
				<xs:restriction base="addml:NonEmptyString">
					<xs:pattern value=".+">
						<xs:annotation>
							<xs:documentation>Other, yet to be specified</xs:documentation>
						</xs:annotation>
					</xs:pattern>
				</xs:restriction>
			</xs:simpleType>
		</xs:union>
	</xs:simpleType>

	<!-- Complex variables -->

	<xs:complexType name="description">
		<xs:annotation>
			<xs:documentation>S000</xs:documentation>
			<xs:documentation>Description of unit</xs:documentation>
			<xs:documentation>No topic-attribute defines "What is.."</xs:documentation>
		</xs:annotation>
		<xs:simpleContent>
			<xs:extension base="addml:NonEmptyString">
				<xs:attribute name="topic" type="addml:NonEmptyString">
					<xs:annotation>
						<xs:documentation>Ex: 'Usage', 'History', 'Comments'</xs:documentation>
						<xs:documentation>No topic defines the basic understanding of the unit</xs:documentation>
					</xs:annotation>
				</xs:attribute>
			</xs:extension>
		</xs:simpleContent>
	</xs:complexType>

	<xs:group name="ValueOrObject">
		<xs:annotation>
			<xs:documentation>Choose between a value or complex object</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="value" type="addml:value"/>
			<xs:element name="object" type="addml:object"/>
		</xs:choice>
	</xs:group>

	<xs:complexType name="versionDataType">
		<xs:simpleContent>
			<xs:extension base="addml:NonEmptyString">
				<xs:attribute name="scheme" default="Semantic">
					<xs:annotation>
						<xs:documentation/>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="addml:NonEmptyString">
							<xs:enumeration value="Semantic">
								<xs:annotation>
									<xs:documentation/>
								</xs:annotation>
							</xs:enumeration>
							<xs:enumeration value="Calendar">
								<xs:annotation>
									<xs:documentation/>
								</xs:annotation>
							</xs:enumeration>
							<xs:pattern value=".+">
								<xs:annotation>
									<xs:documentation>Other schemes</xs:documentation>
								</xs:annotation>
							</xs:pattern>
						</xs:restriction>
					</xs:simpleType>
				</xs:attribute>
			</xs:extension>
		</xs:simpleContent>
	</xs:complexType>

	<xs:simpleType name="relationDataType">
		<xs:annotation>
			<xs:documentation>List of values defining the relationship between records</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="1:1">
				<xs:annotation>
					<xs:documentation>One-to-one</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="1:N">
				<xs:annotation>
					<xs:documentation>One-to-many</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="N:1">
				<xs:annotation>
					<xs:documentation>Many-to-one</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="N:M">
				<xs:annotation>
					<xs:documentation>Many-to-many</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>

	<xs:complexType name="resource">
		<xs:annotation>
			<xs:documentation>S000</xs:documentation>
			<xs:documentation>Relative path to resource included in dataset</xs:documentation>
		</xs:annotation>
		<xs:simpleContent>
			<xs:extension base="xs:anyURI">
				<xs:attribute name="name" type="xs:string">
					<xs:annotation>
						<xs:documentation>Official name of resource</xs:documentation>
					</xs:annotation>
				</xs:attribute>
			</xs:extension>
		</xs:simpleContent>
	</xs:complexType>

	<!-- Abstract variables -->

	<xs:simpleType name="NonEmptyString">
		<xs:annotation>
			<xs:documentation>S000</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:minLength value="1"/>
		</xs:restriction>
	</xs:simpleType>

</xs:schema>
