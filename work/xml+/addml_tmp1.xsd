	<!-- 6: Queries -->

	<xs:complexType name="querySection">
		<xs:annotation>
			<xs:documentation>C000</xs:documentation>
			<xs:documentation>How to use information</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:choice maxOccurs="unbounded">
				<xs:element name="queryGroup">
					<xs:complexType>
						<xs:complexContent>
							<xs:extension base="addml:unit">
								<xs:sequence>
									<xs:element name="query" type="addml:query" maxOccurs="unbounded"/>
								</xs:sequence>
							</xs:extension>
						</xs:complexContent>
					</xs:complexType>
				</xs:element>
				<xs:element name="query" type="addml:query" maxOccurs="unbounded"/>
			</xs:choice>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="query">
		<xs:annotation>
			<xs:documentation>C000</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="addml:unit">
				<xs:sequence>
					<xs:element name="created" type="xs:date">
						<xs:annotation>
							<xs:documentation>The date of when the statement is documented</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="lastModified" type="xs:date" minOccurs="0">
						<xs:annotation>
							<xs:documentation>The date of when the documentation of the statement is last modified</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="lastUsed" type="xs:date" minOccurs="0">
						<xs:annotation>
							<xs:documentation>The last date of when the query is last used</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="format" type="addml:format">
						<xs:annotation>
							<xs:documentation>Defines the language the statement is written in</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="version" type="addml:versionDataType">
						<xs:annotation>
							<xs:documentation>Defines the version of the language the statement is written in</xs:documentation>
						</xs:annotation>
					</xs:element>
 					<xs:element name="statement" type="addml:NonEmptyString" maxOccurs="unbounded">
					</xs:element>
					<xs:element name="record" type="addml:recordObject" />
			</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	
	<!-- 7: Definitions -->

	<xs:complexType name="definitionSection">
		<xs:annotation>
			<xs:documentation>C000</xs:documentation>
			<xs:documentation>How to understand information</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:choice minOccurs="0" maxOccurs="unbounded">
				<xs:element name="definition" type="addml:definitionUnit"/>
				<xs:element name="key" type="addml:keyUnit"/>
			</xs:choice>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="definitionUnit">
		<xs:complexContent>
			<xs:extension base="addml:unit">
				<xs:sequence>
					<xs:element name="type">
						<xs:annotation>
							<xs:documentation>The type of definition, i.e. "Extraction" or "Record"</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="version" type="addml:versionDataType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Connected to variantOf, displaying a specific iteration of a definition</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="documentation" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Documentation in reference-section</xs:documentation>
						</xs:annotation>
						<xs:complexType>
							<xs:attribute name="reference">
								<xs:annotation>
									<xs:documentation>Reference to documentation in reference-section</xs:documentation>
								</xs:annotation>
							</xs:attribute>
						</xs:complexType>
					</xs:element>
					<xs:element name="incomplete" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Shows if a object is described in full or less</xs:documentation>
						</xs:annotation>
						<xs:complexType/>
					</xs:element>
					<xs:element name ="relation" type="addml:relationType" minOccurs="0" maxOccurs="unbounded" />
				</xs:sequence>
				<xs:attribute name="typeReference" type="addml:typeReference">
					<xs:annotation>
						<xs:documentation>Specifies an expected format.</xs:documentation>
					</xs:annotation>
				</xs:attribute>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	
	<xs:complexType name="relationType">
		<xs:annotation>
			<xs:documentation>Creating building blocks of definitions</xs:documentation>
		</xs:annotation>
		<xs:choice maxOccurs="unbounded">
			<xs:element name="relation" type="addml:relationType" />
			<xs:element name="definition" >
				<xs:annotation>
					<xs:documentation>Linking relations between definitions</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:attribute name="reference" type="addml:definitionReference" use="required"/>
					<xs:attributeGroup ref="addml:MinMaxAttributes"/>
				</xs:complexType>
			</xs:element>
		</xs:choice>
		<xs:attribute name="type" type="addml:conceptDataValue" use="required">
			<xs:annotation>
				<xs:documentation>Description of the relation between definitions</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>

	<xs:complexType name="keyUnit">
		<xs:complexContent>
			<xs:extension base="addml:unit">
				<xs:sequence>
					<xs:choice>
						<xs:element name="primaryKey">
							<xs:complexType/>
						</xs:element>
						<xs:element name="alternateKey">
							<xs:complexType/>
						</xs:element>
						<xs:element name="foreignKey">
							<xs:complexType>
								<xs:sequence>
									<xs:element name="container" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Reference to another solution, system or filstructure, documented as a container</xs:documentation>
										</xs:annotation>
										<xs:complexType>
											<xs:attribute name="definitionReference" type="addml:definitionReference" use="required"/>
										</xs:complexType>
									</xs:element>
									<xs:element name="record">
										<xs:annotation>
											<xs:documentation>Reference to recording</xs:documentation>
										</xs:annotation>
										<xs:complexType>
											<xs:attribute name="definitionReference" type="addml:definitionReference" use="required"/>
										</xs:complexType>
									</xs:element>
									<xs:element name="field" maxOccurs="unbounded">
										<xs:annotation>
											<xs:documentation>Reference to recording</xs:documentation>
										</xs:annotation>
										<xs:complexType>
											<xs:attribute name="definitionReference" type="addml:definitionReference" use="required"/>
										</xs:complexType>
									</xs:element>
								</xs:sequence>
								<xs:attribute name="relation" type="addml:relationDataType" use="required" />
							</xs:complexType>
						</xs:element>
					</xs:choice>
					<xs:element name="record">
						<xs:annotation>
							<xs:documentation>Reference to record</xs:documentation>
						</xs:annotation>
						<xs:complexType>
							<xs:attribute name="definitionReference" type="addml:definitionReference" use="required"/>
						</xs:complexType>
					</xs:element>
					<xs:element name="field" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Reference to field</xs:documentation>
						</xs:annotation>
						<xs:complexType>
							<xs:attribute name="definitionReference" type="addml:definitionReference" use="required"/>
						</xs:complexType>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<!-- 8: Types -->

	<xs:complexType name="typeSection">
		<xs:annotation>
			<xs:documentation>C000</xs:documentation>
			<xs:documentation>How to read information</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="type" type="addml:typeUnit" minOccurs="0" maxOccurs="unbounded"/>
