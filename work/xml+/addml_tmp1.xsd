<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:addml="http://www.arkivverket.no/standarder/addml/v9"
	xmlns:xs="http://www.w3.org/2001/XMLSchema"
	targetNamespace="http://www.arkivverket.no/standarder/addml/v9" elementFormDefault="qualified"
	version="9.0">
	<xs:annotation>
		<xs:documentation xml:lang="en">
			Changes made in versions up to 8.2 are not documented in
			this document.
			Updated 2014-08-15 and 2014-09-29, Terje Pettersen-Dahl:
			Version 8.3:
			1. Element reference in dataset made optional.
			2. Optional possibility for header-lines.
			3. FieldDefinitionReference made unique within an instance.
			4. Created this documentation section.
		</xs:documentation>
		<xs:documentation xml:lang="en">
			Version 9.0:
			1. Changed all elements to complex- or simpletype, except root-element.
			2. Changed structure from specialised to object-oriented, where new objects may be implemented on abstract types.
			3. Clarification: All indices are 1-based.
			4. Locked down certain properties for objects, while allowing flexibility with 'additionalInfo'.
		</xs:documentation>
	</xs:annotation>

	<!-- 0: Root-elements -->

	<xs:element name="addml">
		<xs:annotation>
			<xs:documentation>C000</xs:documentation>
			<xs:documentation>Root-element for addml-document</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="dataset" type="addml:dataset" maxOccurs="unbounded" />
			</xs:sequence>
			<xs:attribute name="name" type="addml:name" use="required">
				<xs:annotation>
					<xs:documentation>Unique name of this document</xs:documentation>
				</xs:annotation>
			</xs:attribute>
		</xs:complexType>
	</xs:element>

	<xs:element name="addmlCatalog">
		<xs:annotation>
			<xs:documentation>C000</xs:documentation>
			<xs:documentation>Root-element for addml's catalog-document</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:annotation>
				<xs:documentation>C000</xs:documentation>
				<xs:documentation>Contains everything besides the structure and query, to understand information such as a logical model or a standard.</xs:documentation>
			</xs:annotation>
			<xs:sequence>
				<xs:element name="catalog" type="addml:catalogSection" minOccurs="0" maxOccurs="unbounded" />
				<xs:element name="context" type="addml:contextSection" minOccurs="0"/>
				<xs:element name="content" type="addml:contentSection" minOccurs="0"/>
				<xs:element name="definitions" type="addml:definitionSection" />
				<xs:element name="types" type="addml:typeSection" minOccurs="0" />
				<xs:element name="processes" type="addml:processSection" minOccurs="0" />
			</xs:sequence>
			<xs:attribute name="name" type="addml:name" use="required">
				<xs:annotation>
					<xs:documentation>Unique name of this document</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="created" type="xs:date" use="required">
				<xs:annotation>
					<xs:documentation>The date of when the catalog is documented</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="lastModified" type="xs:date">
				<xs:annotation>
					<xs:documentation>The date of when the documentation of the catalog is last modified</xs:documentation>
				</xs:annotation>
			</xs:attribute>
		</xs:complexType>
	</xs:element>

	<!-- Main components -->

	<!-- 2: Dataset -->

	<xs:complexType name="dataset">
		<xs:annotation>
			<xs:documentation>C000</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="catalogs" type="addml:catalogSection" minOccurs="0" maxOccurs="unbounded" />
			<xs:element name="context" type="addml:contextSection" minOccurs="0"/>
			<xs:element name="content" type="addml:contentSection" minOccurs="0"/>
			<xs:element name="structure" type="addml:structureSection" />
			<xs:element name="queries" type="addml:querySection" minOccurs="0" />
			<xs:element name="definitions" type="addml:definitionSection" minOccurs="0" />
			<xs:element name="types" type="addml:typeSection" minOccurs="0" />
			<xs:element name="processes" type="addml:processSection" minOccurs="0" />
		</xs:sequence>
		<xs:attribute name="name" type="addml:name" use="required" />
		<xs:attribute name="created" type="xs:date" use="required">
			<xs:annotation>
				<xs:documentation>Date when the dataset is documented</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="lastModified" type="xs:date">
			<xs:annotation>
				<xs:documentation>Date when the dataset is last modified</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>
	
	<!-- 3: Catalog -->

	<xs:complexType name="catalogSection">
		<xs:annotation>
			<xs:documentation>C000</xs:documentation>
			<xs:documentation>List of files containing pre-defined units</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="catalog" type="addml:catalogElement" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="catalogElement">
		<xs:annotation>
			<xs:documentation>C000</xs:documentation>
			<xs:documentation>External file containing pre-defined units</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="addml:unit">
				<xs:sequence>
					<xs:element name="fileReference" type="addml:NonEmptyString">
						<xs:annotation>
							<xs:documentation>Reference to the file</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<!-- 4: Context -->

	<xs:complexType name="contextSection">
		<xs:annotation>
			<xs:documentation>C000</xs:documentation>
			<xs:documentation>Information regarding the context of the described material</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="agent" type="addml:agent" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="documentation" type="addml:documentationElement" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="comments" minOccurs="0" type="addml:commentElements" />
			<xs:element name="additionalElements" minOccurs="0">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="element" type="addml:element" maxOccurs="unbounded"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="agent">
		<xs:annotation>
			<xs:documentation>C000</xs:documentation>
			<xs:documentation>Defines an agent involved in the process of creating, preserving or other in the present or earlier archival environment</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="addml:element">
				<xs:sequence>
					<xs:element name="resource" type="addml:resource" minOccurs="0" maxOccurs="unbounded"/>
				</xs:sequence>
				<xs:attribute name="role" type="addml:role" use="required"/>
				<xs:attribute name="otherrole" type="addml:NonEmptyString"/>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:complexType name="documentationElement">
		<xs:annotation>
			<xs:documentation>C000</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="addml:element">
				<xs:sequence>
					<xs:element name="title" type="addml:NonEmptyString">
						<xs:annotation>
							<xs:documentation>Formal name of documentation</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="version" type="addml:versionDataType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Version of the archived documentation</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="resource" type="addml:resource" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Source of documentation</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:complexType name="commentElements">
		<xs:annotation>
			<xs:documentation>C000</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="comment" maxOccurs="unbounded">
				<xs:complexType>
					<xs:annotation>
						<xs:documentation/>
					</xs:annotation>
					<xs:sequence>
						<xs:group ref="addml:ValueOrObject" maxOccurs="unbounded"/>
						<xs:element name="regarding" type="addml:NonEmptyString" minOccurs="0" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>Reference to base-unit</xs:documentation>
								<xs:documentation>
									Ex: value='Testing fails due to missing documents'
									regarding 'reference to process' and 'reference to folder with documents'
								</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<!-- 4: Content -->

	<xs:complexType name="contentSection">
		<xs:annotation>
			<xs:documentation>C000</xs:documentation>
			<xs:documentation>Information regarding the content of the described material</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="container" type="addml:containerElement" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="documentation" type="addml:documentationElement" minOccurs="0" maxOccurs="unbounded" />
			<xs:element name="comments" type="addml:commentElements" minOccurs="0" />
			<xs:element name="additionalElements" minOccurs="0">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="element" type="addml:element" maxOccurs="unbounded"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="containerElement">
		<xs:annotation>
			<xs:documentation>C000</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="addml:element">
				<xs:sequence>
					<xs:element name="type" type="addml:NonEmptyString">
						<xs:annotation>
							<xs:documentation>Extraction-classification, </xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="version" type="addml:versionDataType" minOccurs="0">
						<xs:annotation>
							<xs:documentation/>
						</xs:annotation>
					</xs:element>
					<xs:element name="subjects" type="addml:NonEmptyString" minOccurs="0" maxOccurs="unbounded" />
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<!-- 5: Structure -->

	<xs:complexType name="structureSection">
		<xs:annotation>
			<xs:documentation>C000</xs:documentation>
			<xs:documentation>Where to find information</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="container" type="addml:containerObject" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>
	
	<!-- 5.1 Basic objects -->

	<xs:complexType name="containerObject" abstract="true">
		<xs:annotation>
			<xs:documentation>C000</xs:documentation>
			<xs:documentation>Physical data-location, such as file-structure, system or database</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="addml:unit">
				<xs:attribute name="definitionReference" type="addml:definitionReference" use="required"/>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:complexType name="folderObject">
		<xs:annotation>
			<xs:documentation>C000</xs:documentation>
			<xs:documentation>Basic folder</xs:documentation>
			<xs:documentation>References significant files or folders</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="addml:unit">
				<xs:sequence>
					<xs:element name="path" type="addml:name">
						<xs:annotation>
							<xs:documentation>Path to folder relative to the addml-file.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="numberOfOccurrences" type="addml:numberOfOccurrences" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Number of files. '*.*' signifies all files.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:choice minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Files or subfolders. TODO:why</xs:documentation>
						</xs:annotation>
						<xs:element name="file" type="addml:fileObject"/>
						<xs:element name="folder" type="addml:folderObject"/>
					</xs:choice>
				</xs:sequence>
				<xs:attribute name="content" type="addml:folderType" use="required">
					<xs:annotation>
						<xs:documentation>Type of content in folder.</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="definitionReference" type="addml:definitionReference" use="required"/>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:complexType name="dataFolderObject">
		<xs:complexContent>
			<xs:extension base="addml:folderObject">
				<xs:sequence>
					<xs:element name="targetNamespace" type="addml:NonEmptyString" minOccurs="0">
						<xs:annotation>
							<xs:documentation>
								Reference to the main namespace of the
								xml-files in folder.
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="schemas">
						<xs:annotation>
							<xs:documentation>
								Connects to one or more validation-files.
							</xs:documentation>
						</xs:annotation>
						<xs:complexType>
							<xs:sequence>
								<xs:element name="schema" maxOccurs="unbounded">
									<xs:annotation>
										<xs:documentation>Connects a validation-file to a xml-file.</xs:documentation>
									</xs:annotation>
									<xs:complexType>
										<xs:attribute name="namespace" type="addml:NonEmptyString">
											<xs:annotation>
												<xs:documentation>Reference to the namespace of the xml-schema.</xs:documentation>
											</xs:annotation>
										</xs:attribute>
										<xs:attribute name="prefix" type="addml:NonEmptyString">
											<xs:annotation>
												<xs:documentation>Prefix of the namespace of the xml-schema in main schema.</xs:documentation>
											</xs:annotation>
										</xs:attribute>
										<xs:attribute name="fileReference" type="addml:NonEmptyString">
											<xs:annotation>
												<xs:documentation>Reference to the file to validate the xml-file against.</xs:documentation>
											</xs:annotation>
										</xs:attribute>
									</xs:complexType>
								</xs:element>
							</xs:sequence>
						</xs:complexType>
					</xs:element>
				</xs:sequence>
				<xs:attribute name="content" type="addml:folderType" use="required" fixed="DATAFILES" />
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:complexType name="fileObject">
		<xs:annotation>
			<xs:documentation>C000</xs:documentation>
			<xs:documentation>A basic file</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="addml:unit">
				<xs:sequence>
					<xs:element name="path" type="addml:NonEmptyString">
						<xs:annotation>
							<xs:documentation>Path to file, relative to the addml-file.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="checksum">
						<xs:annotation>
							<xs:documentation>
								Contains the algorithm and value of filehash-calculation.
							</xs:documentation>
						</xs:annotation>
						<xs:complexType>
							<xs:simpleContent>
								<xs:extension base="addml:NonEmptyString">
									<xs:attribute name="algorithm" type="addml:algorithmValue" default="SHA-256">
										<xs:annotation>
											<xs:documentation>Algorithm used for filehash-calculation</xs:documentation>
										</xs:annotation>
									</xs:attribute>
								</xs:extension>
							</xs:simpleContent>
						</xs:complexType>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:complexType name="dataFile">
		<xs:annotation>
			<xs:documentation>C000</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="addml:fileObject">
				<xs:sequence>
					<xs:element name="numberOfOccurrences" type="addml:numberOfOccurrences" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>
								Number of occurrences per record identified in file or total
								number of records in file
							</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
				<xs:attribute name="definitionReference" type="addml:definitionReference" use="required"/>
				<xs:attribute name="typeReference" type="addml:typeReference" use="required"/>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:complexType name="groupObject">
		<xs:annotation>
			<xs:documentation>C000</xs:documentation>
			<xs:documentation>Non-record information-object, grouping similar fields or records</xs:documentation>
		</xs:annotation>
	</xs:complexType>

	<xs:complexType name="recordObject" abstract="true">
		<xs:annotation>
			<xs:documentation>C000</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="addml:unit">
				<xs:attribute name="definitionReference" type="addml:definitionReference" use="required"/>
				<xs:attribute name="typeReference" type="addml:typeReference" use="optional"/>
				<xs:attributeGroup ref="addml:MinMaxAttributes"/>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:complexType name="fieldObject" abstract="true">
		<xs:annotation>
			<xs:documentation>C000</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="addml:unit">
				<xs:sequence>
					<xs:element name="unique" minOccurs="0">
						<xs:annotation>
							<xs:documentation/>
						</xs:annotation>
						<xs:complexType/>
					</xs:element>
					<xs:element name="nullValues" minOccurs="0">
						<xs:complexType>
							<xs:sequence>
								<xs:element name="nullValue" type="xs:string" maxOccurs="unbounded"/>
							</xs:sequence>
						</xs:complexType>
					</xs:element>
					<xs:element name="code" type="addml:codeObject" minOccurs="0" maxOccurs="unbounded"/>
				</xs:sequence>
				<xs:attribute name="definitionReference" type="addml:definitionReference" use="required"/>
				<xs:attribute name="typeReference" type="addml:typeReference" use="optional"/>
				<xs:attributeGroup ref="addml:MinMaxAttributes"/>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:complexType name="attributeObject">
		<xs:annotation>
			<xs:documentation>C000</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="addml:unit">
				<xs:sequence>
					<xs:element name="unique" minOccurs="0">
						<xs:annotation>
							<xs:documentation/>
						</xs:annotation>
						<xs:complexType/>
					</xs:element>
					<xs:element name="nullValues" minOccurs="0">
						<xs:complexType>
							<xs:sequence>
								<xs:element name="nullValue" type="xs:string" maxOccurs="unbounded"/>
							</xs:sequence>
						</xs:complexType>
					</xs:element>
					<xs:element name="code" type="addml:codeObject" minOccurs="0" maxOccurs="unbounded"/>
				</xs:sequence>
				<xs:attribute name="definitionReference" type="addml:definitionReference" use="required"/>
				<xs:attribute name="typeReference" type="addml:typeReference" use="optional"/>
				<xs:attributeGroup ref="addml:MinMaxAttributes"/>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:complexType name="codeObject">
		<xs:annotation>
			<xs:documentation>C000</xs:documentation>
			<xs:documentation>Coded value in a field.</xs:documentation>
			<xs:documentation>Ex. 0, 1 or A, B, C</xs:documentation>
		</xs:annotation>
		<xs:simpleContent>
			<xs:extension base="xs:string">
				<xs:attribute name="definitionReference" type="addml:definitionReference"
					use="required"/>
			</xs:extension>
		</xs:simpleContent>
	</xs:complexType>

	<xs:complexType name="IdentifyingFieldValues">
		<xs:annotation>
			<xs:documentation>Values identifying type of record.</xs:documentation>
			<xs:documentation>Obligatory when file contains multiple records</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="fieldValue" type="addml:value" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Field-value</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<!-- 5.2: Container objects -->

	<xs:group name="FilesAndFolders">
		<xs:sequence>
			<xs:choice maxOccurs="unbounded">
				<xs:element name="file" type="addml:fileObject" />
				<xs:element name="folder" type="addml:folderObject" />
			</xs:choice>
		</xs:sequence>
	</xs:group>

	<!-- 5.2.1: Extraction-type objects -->

	<xs:complexType name="extraction">
		<xs:annotation>
			<xs:documentation>Root-catalog for files and folders making up an export of archival data from regular data.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="addml:containerObject">
				<xs:sequence>
					<xs:group ref="addml:FilesAndFolders"/>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:complexType name="files">
		<xs:annotation>
			<xs:documentation>File-catalog for files and folders not yet described</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="addml:containerObject">
				<xs:sequence>
					<xs:group ref="addml:FilesAndFolders"/>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<!-- 5.2.2: System objects -->

	<xs:complexType name="system">
		<xs:annotation>
			<xs:documentation>C000</xs:documentation>
		</xs:annotation>
	</xs:complexType>

	<!-- 5.2.3: Database objects -->

	<xs:complexType name="database">
		<xs:annotation>
			<xs:documentation>C000</xs:documentation>
		</xs:annotation>
	</xs:complexType>

	<!-- 5.3: Fixed-length objects -->

	<xs:complexType name="fixedFile">
		<xs:complexContent>
			<xs:extension base="addml:dataFile">
				<xs:sequence>
					<xs:element name="IdentifyingFields" minOccurs="0">
						<xs:annotation>
							<xs:documentation>
								Field-index or indices identifying type of
								record.
							</xs:documentation>
							<xs:documentation>
								Obligatory when file contains multiple
								records.
							</xs:documentation>
						</xs:annotation>
						<xs:complexType>
							<xs:sequence>
								<xs:element name="fieldIndex" type="xs:nonNegativeInteger"
									maxOccurs="unbounded">
									<xs:annotation>
										<xs:documentation>Index of field in record</xs:documentation>
									</xs:annotation>
								</xs:element>
							</xs:sequence>
						</xs:complexType>
					</xs:element>
					<xs:element name="record" type="addml:recordObject" />
					<xs:choice minOccurs="0" maxOccurs="unbounded">
						<xs:element name="record" type="addml:recordObject" />
						<xs:element name="recordRef" type="addml:recordObject">
							<xs:annotation>
								<xs:documentation>Record referenced inside the hiearchy. Placed along the root-record for cycle-free references.</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:choice>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:complexType name="fixedRecord">
		<xs:annotation>
			<xs:documentation>TODO</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
